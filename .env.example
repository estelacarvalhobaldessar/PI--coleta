# Modelo do .env (configuração única do Écoleta).
# Copie para .env, na raiz do projeto. O mesmo arquivo é lido pelo app (Node), pela api e pelo website (PHP).

# Banco de dados (MySQL). Padrão do XAMPP: usuário root, sem senha, porta 3306.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=ecoleta
DB_USER=root
DB_PASSWORD=

# Apache, onde rodam a api e o website.
# APACHE_PORT: 80 no Apache padrão, 8080 se o XAMPP foi configurado assim.
# API_PATH: caminho da pasta api a partir da raiz do Apache (htdocs).
APACHE_HOST=localhost
APACHE_PORT=8080
API_PATH=/gurias-ecoleta-main/api

# Porta do servidor Express do app. O Vite usa 5173 e repassa /api para esta porta.
PORT=8787

# Chave que assina o cookie de sessão. Gere com: openssl rand -hex 32
SESSION_SECRET=

# Token que o app envia à api no cabeçalho X-Api-Token. Gere com: openssl rand -hex 32
# Use um valor diferente do SESSION_SECRET.
INTERNAL_API_TOKEN=

# Chave do openrouteservice, para calcular a rota do caminhão.
# Crie uma conta gratuita em https://openrouteservice.org/dev/#/signup e copie o token do painel.
ORS_API_KEY=
