# Dependências e build do app (React + Express)
node_modules/
dist/
dist-ssr/
*.local

# O .env da raiz É versionado (configuração única do app, da api e do website).
# Variações locais, não:
.env.local
.env.*.local

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Cache de ferramentas
.eslintcache
coverage/

